VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only; use the publishable key above for new projects.
VITE_SUPABASE_ANON_KEY=
# Public HTTPS web URL allowed in Supabase Auth redirects.
# Android uses pe.speedtrack.app://auth/callback; allow that exact URL in Supabase.
VITE_AUTH_REDIRECT_URL=
# Optional public/restricted OpenRouteService key. VITE_* values are visible in the app.
VITE_ROUTING_API_KEY=
VITE_ROUTING_URL=https://api.heigit.org/openrouteservice
VITE_GEOCODING_URL=https://api.heigit.org/pelias/v1
# Optional HTTPS proxy implementing the traffic contract documented in README.
VITE_TRAFFIC_URL=
